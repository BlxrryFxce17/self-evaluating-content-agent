# ====================================================================
# Configuration for Self-Evaluating Lesson Generator Agent
# ====================================================================
# You can set any ONE of the following API keys, or leave them blank
# to run in the high-fidelity offline deterministic engine.

# Google Gemini (Default recommended)
GEMINI_API_KEY=

# OpenAI (Alternative)
OPENAI_API_KEY=

# Groq (Alternative)
GROQ_API_KEY=

# Execution Settings
DEFAULT_MODEL_PROVIDER=auto    # "auto", "gemini", "openai", "groq", or "offline"
MAX_RETRIES=2                  # Hard safety termination limit
ENABLE_SELF_EVOLVING_MEMORY=true
LOG_LEVEL=INFO

